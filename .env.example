# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit it.

# Pinokio gateway base URL (dev or live). A trailing slash is tolerated.
PINOKIO_BASE_URL=https://pinokio.example.com

# API key created at <base URL>/apikeys. Shown once, starts with pk_.
PINOKIO_API_KEY=pk_REPLACE_WITH_YOUR_KEY
